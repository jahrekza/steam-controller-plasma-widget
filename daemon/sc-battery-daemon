#!/usr/bin/env python3
"""
Steam Controller 2 battery daemon.

Key finding (2026-06-30):
  Report 0x43, byte[2] = battery % at session start, then increments as
  a session uptime counter (~1 per minute). Verified at:
    4%  → byte[2] = 4   (2026-06-30 14:28)
    50% → byte[2] = 44  (2026-06-12)
   100% → byte[2] = 97  (2026-06-30 19:35, ~12 min into session → started ~85-100)

  Strategy: capture byte[2] from the FIRST 0x43 report after each connection.
  That value = battery % at the moment the pad connected/woke up.
"""

import os, json, time, select, fcntl, struct
from datetime import datetime

DEV_VID   = 0x28de
DEV_PID   = 0x1304
OUT_FILE  = "/tmp/sc-battery.json"
READ_SIZE = 64


def find_sc_hidraw():
    for i in range(20):
        dev = f"/dev/hidraw{i}"
        try:
            fd = os.open(dev, os.O_RDWR)
            buf = bytearray(8)
            fcntl.ioctl(fd, 0x80084803, buf, True)
            os.close(fd)
            _, vendor, product = struct.unpack("ihh", bytes(buf))
            if vendor == DEV_VID and product == DEV_PID:
                fd2 = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
                live = bool(select.select([fd2], [], [], 0.3)[0])
                os.close(fd2)
                if live:
                    return dev
        except Exception:
            pass
    return None


def write_json(pct, connected, charging, last_seen):
    data = {
        "battery_pct": pct,
        "connected":   connected,
        "charging":    charging,
        "last_seen":   last_seen,
        "provisional": False,
        "updated_at":  datetime.now().isoformat(timespec="seconds"),
    }
    tmp = OUT_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, OUT_FILE)


def main():
    print(f"[{datetime.now():%H:%M:%S}] SC Battery Daemon starting", flush=True)

    battery_pct    = -1
    last_seen      = ""
    session_b2     = None   # byte[2] captured at session start
    session_writes = 0      # writes since session start
    WRITE_EVERY    = 3000   # reads (~30s at ~100 r/s)

    while True:
        dev = find_sc_hidraw()
        if not dev:
            write_json(battery_pct, False, True, last_seen)
            time.sleep(5)
            continue

        print(f"[{datetime.now():%H:%M:%S}] Connected: {dev}", flush=True)
        session_b2     = None
        session_writes = 0
        reads          = 0
        silent_ticks   = 0

        try:
            fd = os.open(dev, os.O_RDONLY)

            while True:
                r, _, _ = select.select([fd], [], [], 5.0)

                if not r:
                    silent_ticks += 1
                    if silent_ticks >= 2:
                        write_json(battery_pct, False, True, last_seen)
                    continue

                silent_ticks = 0
                data = os.read(fd, READ_SIZE)
                reads += 1
                last_seen = datetime.now().strftime("%H:%M")

                if data[0] == 0x43 and len(data) >= 3:
                    b2 = data[2]

                    if session_b2 is None:
                        # First 0x43 of this session — byte[2] = battery %
                        session_b2  = b2
                        battery_pct = min(100, max(0, int(b2)))
                        print(f"[{datetime.now():%H:%M:%S}] Session start: byte[2]={b2} → battery={battery_pct}%", flush=True)

                if reads % WRITE_EVERY == 0:
                    write_json(battery_pct, True, False, last_seen)
                    session_writes += 1
                    print(f"[{datetime.now():%H:%M:%S}] battery={battery_pct}% session_b2={session_b2}", flush=True)

        except OSError as e:
            print(f"[{datetime.now():%H:%M:%S}] Device lost ({e}), reconnecting…", flush=True)
            write_json(battery_pct, False, False, last_seen)
        finally:
            try:
                os.close(fd)
            except Exception:
                pass

        time.sleep(2)


if __name__ == "__main__":
    main()
